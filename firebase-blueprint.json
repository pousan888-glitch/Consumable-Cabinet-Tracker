{
  "entities": {
    "Cabinet": {
      "title": "Cabinet",
      "description": "Storage cabinet holding consumables",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "location": { "type": "string" },
        "departments": { "type": "array" },
        "photoUrl": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "location"]
    },
    "Consumable": {
      "title": "Consumable",
      "description": "Consumable item stored in a cabinet",
      "type": "object",
      "properties": {
        "cabinetId": { "type": "string" },
        "name": { "type": "string" },
        "department": { "type": "string" },
        "currentQty": { "type": "number" },
        "minThreshold": { "type": "number" },
        "maxThreshold": { "type": "number" },
        "unit": { "type": "string" },
        "imageUrl": { "type": "string" },
        "lastUpdated": { "type": "string" },
        "lastUpdatedBy": { "type": "string" }
      },
      "required": ["cabinetId", "name", "currentQty"]
    },
    "AppUser": {
      "title": "AppUser",
      "description": "User permission and role profile",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "QC", "HELPER"] },
        "isSuperAdmin": { "type": "boolean" },
        "assignedBy": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "Department": {
      "title": "Department",
      "description": "Factory department entity for grouping cabinets and consumables",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "color": { "type": "string" },
        "createdAt": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["name"]
    },
    "CountHistory": {
      "title": "CountHistory",
      "description": "Inventory counting session log",
      "type": "object",
      "properties": {
        "cabinetId": { "type": "string" },
        "cabinetName": { "type": "string" },
        "checkedAt": { "type": "string" },
        "checkedBy": { "type": "string" },
        "items": { "type": "array" }
      },
      "required": ["cabinetId", "checkedBy"]
    },
    "QCConsumptionHistory": {
      "title": "QCConsumptionHistory",
      "description": "Item consumption and withdrawal log",
      "type": "object",
      "properties": {
        "department": { "type": "string" },
        "consumedAt": { "type": "string" },
        "consumedBy": { "type": "string" },
        "source": { "type": "string" },
        "cabinetId": { "type": "string" },
        "cabinetName": { "type": "string" },
        "note": { "type": "string" },
        "items": { "type": "array" }
      },
      "required": ["department", "consumedBy"]
    }
  },
  "firestore": {
    "/cabinets/{cabinetId}": {
      "schema": "Cabinet",
      "description": "Cabinets list"
    },
    "/consumables/{consumableId}": {
      "schema": "Consumable",
      "description": "Consumables inventory list"
    },
    "/count_history/{historyId}": {
      "schema": "CountHistory",
      "description": "Inventory count session logs"
    },
    "/qc_consumption_history/{historyId}": {
      "schema": "QCConsumptionHistory",
      "description": "Consumption and withdrawal audit logs"
    },
    "/users/{userId}": {
      "schema": "AppUser",
      "description": "App user roles and access control"
    },
    "/departments/{deptId}": {
      "schema": "Department",
      "description": "Factory departments list"
    }
  }
}
